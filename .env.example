STATEFORGE_DPT_HOST=127.0.0.1
STATEFORGE_DPT_PORT=8463
# Save user configuration in ~/.stateforge-dpt/.env. Paths are independent of cwd.
# Defaults: data in ~/.stateforge-dpt; clones in ~/.stateforge-dpt/projects/.
# STATEFORGE_DPT_DATA_DIR=~/.stateforge-dpt
# STATEFORGE_DPT_WORKING_DIRECTORY=~/.stateforge-dpt
# STATEFORGE_DPT_MCP_ENABLED=true
# STATEFORGE_DPT_MCP_PATH=/mcp
# STATEFORGE_DPT_MCP_MAX_READ_BYTES=128000
# MCP is loopback-only by default. Do not enable remote access without an
# authenticated network boundary.
# STATEFORGE_DPT_MCP_ALLOW_REMOTE=false
# Background reconciliation is enabled by default. Active delivery work uses
# the faster cadence; quiet projects use the idle cadence.
# STATEFORGE_DPT_AUTO_RECONCILE_ENABLED=true
# STATEFORGE_DPT_AUTO_RECONCILE_ACTIVE_SECONDS=45
# STATEFORGE_DPT_AUTO_RECONCILE_IDLE_SECONDS=120
# Optional override; installed releases include the built frontend.
# STATEFORGE_DPT_FRONTEND_DIR=/absolute/path/to/frontend/dist
# Optional override for a different GitHub App.
STATEFORGE_DPT_GITHUB_CLIENT_ID=Iv23lidYTyPNl3LWbjTI
